<?xml version="1.0" encoding="utf-8"?>
<!-- Kids MDM IM: parental controls (org.kidsmdm.im.settings.KidsSettingsActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kidsmdm_settings_back"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@android:string/cancel"
            android:contentDescription="@android:string/cancel" />

        <TextView
            style="@style/Signal.Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/kidsmdm_settings__title" />

        <TextView
            style="@style/Signal.Text.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/kidsmdm_settings__contacts" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/kidsmdm_approved_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/kidsmdm_settings__approved_only" />

        <TextView
            style="@style/Signal.Text.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:text="@string/kidsmdm_settings__approved_only_summary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kidsmdm_approved_contacts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Signal.Text.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/kidsmdm_settings__calls" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/kidsmdm_block_voice_calls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/kidsmdm_settings__block_voice_calls" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/kidsmdm_block_video_calls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/kidsmdm_settings__block_video_calls" />

        <TextView
            style="@style/Signal.Text.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/kidsmdm_settings__notifications" />

        <TextView
            android:id="@+id/kidsmdm_push_status"
            style="@style/Signal.Text.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kidsmdm_push_change"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/kidsmdm_settings__change_delivery" />

        <TextView
            style="@style/Signal.Text.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/kidsmdm_settings__pin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/kidsmdm_change_pin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/parental_pin_gate__change_pin" />

    </LinearLayout>

</ScrollView>
